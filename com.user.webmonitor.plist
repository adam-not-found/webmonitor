<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.webmonitor</string>
    <key>ProgramArguments</key>
    <array>
        <string>TARGET_PYTHON_PATH</string>
        <string>TARGET_HOME_DIR/.webmonitor/monitor.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>TARGET_HOME_DIR/.webmonitor/error.log</string>
    <key>StandardOutPath</key>
    <string>TARGET_HOME_DIR/.webmonitor/output.log</string>
</dict>
</plist>
